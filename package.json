{
  "name": "@beaconed/cli",
  "version": "0.0.3",
  "description": "Command-line interface for the Beaconed v1 API",
  "keywords": [
    "beaconed",
    "cli",
    "command-line",
    "ecommerce",
    "shopify",
    "seo",
    "product-optimization"
  ],
  "author": "Beaconed, Inc.",
  "license": "MIT",
  "homepage": "https://github.com/beaconed/beaconed-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beaconed/beaconed-cli.git"
  },
  "bugs": {
    "url": "https://github.com/beaconed/beaconed-cli/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "beaconed": "./dist/cli.js"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@beaconed/api-client": "^0.0.2",
    "chalk": "^5.0.0",
    "cli-table3": "^0.6.0",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "8.16.0",
    "@typescript-eslint/parser": "8.16.0",
    "eslint": "^9.17.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
